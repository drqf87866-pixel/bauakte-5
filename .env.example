# Bauakte – Umgebungsvariablen
# Kopiere diese Datei als .env und passe die Werte an.

# App-Titel (wird im <title>-Tag verwendet)
APP_TITLE=Bauakte

# Öffentliche URL der App (für Links in E-Mails etc.)
PUBLIC_URL=http://localhost:3000

# Cloudflare Account ID (für R2, D1, AI)
# CLOUDFLARE_ACCOUNT_ID=deine-account-id

# Lokaler Dev-Server Port (optional, Default: 3000)
# PORT=3000