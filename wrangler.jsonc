{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bauakte-5",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bauakte-5",
      "database_id": "f8143f08-a46c-4899-b1b8-f0a1e3e1b9a6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "bauakte-5"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
